generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime: transaction pooler Supabase (porta 6543, ?pgbouncer=true) — adatto al serverless.
  url       = env("DATABASE_URL")
  // Solo per Prisma CLI (migrate / db push): connessione diretta "session" (porta 5432).
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                  @id @default(cuid())
  clerkId               String                  @unique
  name                  String?
  email                 String?
  niche                 String?
  objectives            String?
  plan                  String                  @default("trial")
  verticale             String                  @default("food") // "food" | "care"
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  nomeLocale            String?
  indirizzo             String?
  telefono              String?
  sitoWeb               String?
  descrizioneBot        String?
  maxCoperti            Int?
  publicId              String?                 @unique
  orariApertura         String?
  serviziOfferti        String?
  regolePrenotazione    String?
  menuOfferta           String?
  pagamenti             String?
  infoPratiche          String?
  faq                   String?
  appuntamenti          Appuntamento[]
  contents              Content[]
  conversazioni         Conversazione[]
  dipendenti            Dipendente[]
  leads                 Lead[]
  requisitiTurni        RequisitiTurni[]
  listaAttesa           ListaAttesa[]
  preventivi            Preventivo[]
  slotDisponibili       SlotDisponibile[]
  tavoli                Tavolo[]
  sale                  Sala[]
  gruppiTavoli          GruppoTavoli[]
  turni                 Turno[]
  menuCategorie         MenuCategoria[]
  menuPiatti            MenuPiatto[]
  ordini                Ordine[]
  stampanti             Stampante[]
  printJobs             PrintJob[]
  // Personalizzazione pagina ordine
  menuLogoUrl           String?
  menuColoreP           String?                 @default("#4f46e5")
  menuColoreS           String?                 @default("#ffffff")
  turniServizio         String? // JSON: [{id, nome, oraInizio, oraFine}]
  reparti               String? // JSON: string[] reparti/centri di produzione (es. ["Cucina","Bar"]); null = default Cucina/Bar
  fabbisognoStaff       String? // JSON: [{giorno: 0-6, ruolo: string, persone: number, oraInizio: string, oraFine: string}]
  mapElementi           String? // JSON: [{id, tipo, label, x, y, w, h, colore}]
  blockAsporto          Boolean                 @default(false)
  blockDelivery         Boolean                 @default(false)
  camerierePin          String? // hash bcrypt del PIN per la pagina pubblica camerieri (null = nessun PIN)
  qrTimbraturaFisso     Boolean                 @default(false) // true = QR timbratura fisso stampabile; false = ciclante. Solo il token della modalità scelta è valido.
  // Flowest Care
  pazienti              Paziente[]
  sedute                Seduta[]
  documentiPazienti     DocumentoPaziente[]
  tipiSeduta            TipoSeduta[]
  disponibilitaOverride DisponibilitaOverride[]
  notifiche             Notifica[]
  todo                  Todo[]
  copilotUsage          CopilotUsage[]
  copilotInsight        CopilotInsight[]
  menuStampaConfig      MenuStampaConfig?
  // Flowest Contabilità (owner-only)
  contabilitaConfig     ContabilitaConfig?
  costiFissi            CostoFisso[]
  costiUnaTantum        CostoUnaTantum[]
  fatture               Fattura[]
  chiusureGiorno        ChiusuraGiorno[]
  briefSalvati          BriefSalvato[]
}

// Scelte del menu stampabile (PDF) del locale, condivise tra tutti i dispositivi.
// "dati" è un JSON con config (colori, opzioni) e layout dei piatti per tipo.
model MenuStampaConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  dati      String // JSON
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

// Spesa dell'Assistente AI aggregata per locale e per mese (tutti i dispositivi
// dell'account confluiscono nella stessa riga). costoUsd è la stima in dollari.
model CopilotUsage {
  id          String   @id @default(cuid())
  userId      String
  mese        String // "YYYY-MM" (mese in fuso Europe/Rome)
  costoUsd    Float    @default(0)
  tokenInput  Int      @default(0)
  tokenOutput Int      @default(0)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, mese])
  @@index([userId])
}

// Brief del Copilota generato e persistito lato server (Fase proattività): il cron
// del mattino lo prepara per ogni locale, così il titolare lo trova già pronto invece
// di generarlo a mano. Un record per (locale, periodo): l'ultimo generato sostituisce
// il precedente (upsert). brief/context sono JSON serializzati (TEXT), renderizzati
// dal frontend come per la generazione on-demand.
model BriefSalvato {
  id          String   @id @default(cuid())
  userId      String
  timeframe   String // "daily" | "weekly" | "monthly"
  data        DateTime // giorno di riferimento del brief (mezzanotte italiana)
  brief       String // JSON del Brief (semaforo, headline, why, actions, meta)
  context     String // JSON del BriefContext (i numeri che il frontend disegna)
  generatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, timeframe])
  @@index([userId])
}

// Cache delle "insight card" AI (verdetto di 3 righe in cima a una schermata, es.
// Contabilità). Chiave = (locale, schermata, periodo, riferimento). `hash` è l'impronta
// dei numeri interpretati: se combacia con la richiesta corrente si serve il testo salvato
// SENZA chiamare l'AI (controllo costi). Il brief è JSON (headline+why+status).
model CopilotInsight {
  id          String   @id @default(cuid())
  userId      String
  scope       String // schermata: "contabilita" (estendibile)
  periodo     String // "oggi" | "settimana" | "mese" | "anno"
  riferimento String // ancora del periodo "YYYY-MM-DD" (distingue mesi/settimane diversi)
  hash        String // impronta dei numeri: cambia → si rigenera
  brief       String // JSON del Brief (headline, why, status)
  generatedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, scope, periodo, riferimento])
  @@index([userId])
}

model MenuCategoria {
  id              String       @id @default(cuid())
  userId          String
  nome            String
  ordine          Int          @default(0)
  tipo            String       @default("locale") // "locale" | "asporto"
  reparto         String? // reparto/centro di produzione a cui vanno i piatti (Cucina, Bar, Pizzeria…); null = Cucina
  // Contabilità: aliquota IVA di vendita per i piatti di questa categoria. null = eredita il default del locale (ContabilitaConfig.aliquotaVenditaDefault, tipicamente 0.10 somministrazione). Override tipico: alcolici in asporto (0.22).
  aliquotaVendita Float?
  createdAt       DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id])
  piatti          MenuPiatto[]

  @@index([userId, tipo])
}

model MenuPiatto {
  id              String        @id @default(cuid())
  userId          String
  categoriaId     String
  nome            String
  descrizione     String?
  prezzo          Float
  foodCost        Float? // costo di produzione della porzione (€, NETTO IVA). null = non impostato. Con prezzo → margine e guadagno netto in analytics. Separato per menu tavoli/asporto (righe distinte).
  // Contabilità: override dell'aliquota IVA di vendita sul singolo piatto. null = eredita da MenuCategoria.aliquotaVendita → poi dal default del locale. Raro: solo l'eccezione dell'eccezione.
  aliquotaVendita Float?
  immagineUrl     String?
  allergeni       String[]      @default([]) // 14 allergeni UE (Reg. 1169/2011), es. ["glutine","latte"]
  disponibile     Boolean       @default(true)
  quantita        Int? // counter live rimanente. null = non gestita (illimitato). Scala man mano che i clienti ordinano; a 0 il piatto è "Esaurito". Separato per menu tavoli/asporto perché sono righe distinte.
  quantitaSoglia  Int? // visibilità del counter al cliente: null = mostra sempre (quando gestita); N = mostra "Ne restano X" solo quando quantita <= N.
  etichetta       String? // piccola scritta mostrata al cliente (es. "Best seller", "Il nostro classico").
  etichettaColore String? // colore dell'etichetta (hex, es. "#e11d48"). null = colore di default.
  ordine          Int           @default(0)
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id])
  categoria       MenuCategoria @relation(fields: [categoriaId], references: [id])
  righeOrdine     RigaOrdine[]

  @@index([userId])
  @@index([categoriaId])
}

model Ordine {
  id            String        @id @default(cuid())
  userId        String
  tavolo        String
  tavoloId      String?
  gruppoId      String?
  tipo          String        @default("tavolo") // "tavolo" | "asporto" | "delivery"
  clienteInfo   String? // JSON: {nome, email, telefono, indirizzo, data, ora}
  status        String        @default("nuovo")
  totale        Float
  coperti       Int?
  note          String?
  createdAt     DateTime      @default(now())
  prontoAt      DateTime? // quando l'ordine è marcato "pronto" in cucina (per tempo medio consegna)
  closedAt      DateTime?
  notatoNuovo   Boolean       @default(false) // deprecato: sostituito da notatoReparti (acknowledgment per reparto). Tenuto per compatibilità.
  notatoReparti String? // JSON dei reparti (Cucina/Bar/…) che hanno notato l'arrivo: il pulse rosso si spegne solo nel reparto che clicca, non negli altri
  notatoPronto  Boolean       @default(false) // la mappa Tavoli ha notato l'ordine pronto (conto aperto): spegne il badge "!" su tutti i dispositivi
  user          User          @relation(fields: [userId], references: [id])
  tavoloRel     Tavolo?       @relation(fields: [tavoloId], references: [id])
  gruppoRel     GruppoTavoli? @relation(fields: [gruppoId], references: [id])
  righe         RigaOrdine[]

  @@index([userId, createdAt])
  @@index([tavoloId])
  @@index([gruppoId])
}

model RigaOrdine {
  id              String      @id @default(cuid())
  ordineId        String
  piattoId        String?
  nome            String
  prezzo          Float
  foodCost        Float? // snapshot del food cost del piatto al momento dell'ordine (€/porzione, NETTO IVA). null = non impostato allora. Usato per guadagno netto/margine in analytics.
  aliquotaVendita Float? // snapshot dell'aliquota IVA di vendita al momento dell'ordine. null = non snapshottata (ordini storici) → la contabilità risolve a runtime piatto→categoria→default. Snapshot come foodCost: la storia non cambia se ritocchi le aliquote.
  quantita        Int
  note            String?
  mandata         Int         @default(1) // portata/coursing: 1=antipasti-primi, 2=secondi, 3=dolce. Default 1 = tutto insieme.
  reparto         String? // snapshot del reparto (Cucina/Bar/…) al momento dell'ordine → instradamento coerente anche per ordini passati
  prontaAt        DateTime? // quando la mandata di questa riga è marcata pronta in cucina (coursing per portata)
  pagata          Boolean     @default(false) // deprecato: sostituito da quantitaPagata (tenuto per compatibilità)
  quantitaPagata  Int         @default(0) // quante unità di questa voce sono state pagate (0..quantita), aiuto cassa
  ordine          Ordine      @relation(fields: [ordineId], references: [id])
  piatto          MenuPiatto? @relation(fields: [piattoId], references: [id], onDelete: SetNull)

  @@index([ordineId])
  @@index([piattoId])
}

model Lead {
  id         String   @id @default(cuid())
  userId     String
  name       String
  email      String?
  phone      String?
  status     String   @default("nuovo")
  notes      String?
  cancellato Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Content {
  id           String    @id @default(cuid())
  userId       String
  originalText String
  channel      String
  result       String?
  scheduledAt  DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Appuntamento {
  id                String      @id @default(cuid())
  userId            String
  clienteNome       String?
  clienteEmail      String?
  servizio          String?
  data              DateTime
  durata            Int         @default(60)
  status            String      @default("confermato")
  note              String?
  coperti           Int         @default(1)
  allergie          String?
  occasione         String?
  tavoloId          String?
  tavoliIds         String?
  pazienteId        String? // Flowest Care: collega l'appuntamento a un paziente
  tipoSedutaId      String? // Flowest Care: collega l'appuntamento a un tipo di seduta
  // Flowest Care — proposta di un orario diverso, che il paziente accetta via email
  tokenRisposta     String?     @unique
  messaggioProposta String?
  createdAt         DateTime    @default(now())
  tavolo            Tavolo?     @relation(fields: [tavoloId], references: [id])
  user              User        @relation(fields: [userId], references: [id])
  paziente          Paziente?   @relation(fields: [pazienteId], references: [id])
  tipoSeduta        TipoSeduta? @relation(fields: [tipoSedutaId], references: [id])

  @@index([userId, data])
  @@index([tavoloId])
}

// ── Flowest Care ──────────────────────────────────────────────────────────
model Paziente {
  id           String              @id @default(cuid())
  userId       String
  nome         String
  email        String?
  telefono     String?
  dataNascita  DateTime?
  note         String? // anamnesi / note generali
  cancellato   Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id])
  sedute       Seduta[]
  documenti    DocumentoPaziente[]
  appuntamenti Appuntamento[]
}

model TipoSeduta {
  id           String         @id @default(cuid())
  userId       String
  nome         String
  descrizione  String?
  prezzo       Float          @default(0)
  durata       Int            @default(45) // minuti
  attivo       Boolean        @default(true)
  giorni       String? // JSON array di codici giorno (es. ["lun","mer"]); vuoto/null = tutti i giorni di apertura
  orari        String? // fasce orarie consentite (es. "09:00-13:00, 15:00-18:00"); vuoto/null = tutti gli orari di apertura
  ordine       Int            @default(0)
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id])
  appuntamenti Appuntamento[]
}

model Notifica {
  id        String   @id @default(cuid())
  userId    String
  tipo      String // richiesta | calendario | seduta
  titolo    String
  dettaglio String?
  link      String? // dove portare al click
  letta     Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Todo {
  id        String    @id @default(cuid())
  userId    String
  testo     String
  fatto     Boolean   @default(false)
  // Quando è stata spuntata: 24 ore dopo la voce sparisce da sola.
  // Si azzera se viene rimessa fra le cose da fare.
  fattoAt   DateTime?
  ordine    Int       @default(0)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, ordine])
}

model DisponibilitaOverride {
  id        String   @id @default(cuid())
  userId    String
  data      DateTime // giorno specifico (solo la data conta)
  slots     String // JSON: ["08:00-14:00","16:00-18:00"] — [] = chiuso quel giorno
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, data])
}

model Seduta {
  id             String   @id @default(cuid())
  userId         String
  pazienteId     String
  data           DateTime @default(now())
  tipo           String? // es. Valutazione, Terapia manuale, Rieducazione posturale
  note           String? // cosa è stato fatto, dolore percepito, esercizi assegnati
  // Valorizzato per le sedute nate da un appuntamento segnato "completato".
  // Unique così l'aggiornamento è idempotente e non crea doppioni in cartella.
  appuntamentoId String?  @unique
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
  paziente       Paziente @relation(fields: [pazienteId], references: [id])
}

model DocumentoPaziente {
  id             String   @id @default(cuid())
  userId         String
  pazienteId     String
  nome           String
  url            String? // link esterno (Drive, Dropbox…) — alternativo al file caricato
  // I referti restano nel DB e si scaricano da una route protetta da auth: sono dati
  // sanitari, non possono finire nel bucket pubblico usato per le foto dei piatti.
  contenuto      String? // file caricato, in base64
  mimeType       String?
  dimensione     Int? // byte del file originale
  tipo           String? // referto | prescrizione | radiografia | altro
  // Seduta a cui il documento si riferisce. Due colonne perché una seduta può
  // essere ancora un appuntamento in agenda (non svolto) oppure già una voce di
  // cartella clinica; ne è valorizzata al massimo una, nessuna = documento generico.
  appuntamentoId String?
  sedutaId       String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
  paziente       Paziente @relation(fields: [pazienteId], references: [id])

  @@index([pazienteId, appuntamentoId])
  @@index([pazienteId, sedutaId])
}

model GruppoTavoli {
  id        String   @id @default(cuid())
  userId    String
  label     String
  data      String?
  turnoId   String?
  oraFine   String?
  auto      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  tavoli    Tavolo[]
  ordini    Ordine[]

  @@index([userId, data])
}

model Sala {
  id          String   @id @default(cuid())
  userId      String
  nome        String
  ordine      Int      @default(0)
  mapElementi String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  tavoli      Tavolo[]

  @@index([userId])
}

model Tavolo {
  id           String         @id @default(cuid())
  userId       String
  numero       Int
  etichetta    String?
  posti        Int            @default(4)
  note         String?
  gruppoId     String?
  salaId       String?
  mapX         Float?
  mapY         Float?
  mapW         Float?
  mapH         Float?
  mapForma     String?
  mapColore    String?
  createdAt    DateTime       @default(now())
  appuntamenti Appuntamento[]
  ordini       Ordine[]
  user         User           @relation(fields: [userId], references: [id])
  gruppo       GruppoTavoli?  @relation(fields: [gruppoId], references: [id])
  sala         Sala?          @relation(fields: [salaId], references: [id])

  @@index([userId])
  @@index([gruppoId])
  @@index([salaId])
}

model ListaAttesa {
  id           String   @id @default(cuid())
  userId       String
  clienteNome  String
  clienteEmail String?
  clienteTel   String?
  data         DateTime
  ora          String
  coperti      Int      @default(1)
  note         String?
  status       String   @default("in_attesa")
  preventivoId String?
  leadId       String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model Dipendente {
  id                         String                    @id @default(cuid())
  userId                     String
  nome                       String
  email                      String
  ruolo                      String?
  fotoUrl                    String?
  ordine                     Int                       @default(0) // ordine di visualizzazione scelto dal titolare (turni + lista)
  // Contabilità F2 · Labor cost. paga netta oraria in tasca al dipendente; il moltiplicatore aggiunge i costi aziendali nascosti (INPS/INAIL/TFR/13ª/14ª ≈ +40%). Costo orario reale = paga * moltiplicatore.
  pagaOrariaBaseNetta        Float?
  moltiplicatoreCostoAzienda Float                     @default(1.40)
  username                   String?
  passwordHash               String?
  mustChangePassword         Boolean                   @default(true)
  token                      String?                   @unique
  tokenExpiry                DateTime?
  createdAt                  DateTime                  @default(now())
  user                       User                      @relation(fields: [userId], references: [id])
  richieste                  RichiestaDipendente[]
  turni                      Turno[]
  disponibilita              DisponibilitaDipendente[]
  timbrature                 Timbratura[]
  pagaStorico                DipendentePagaStorico[]

  @@unique([userId, username])
  @@index([userId])
}

// Contabilità F2 · Storico tariffe del dipendente con date di validità. Il costo di un
// turno usa la tariffa in vigore alla DATA del turno (l'ultima con dataInizio <= data):
// così un aumento vale solo da lì in avanti e non riscrive la contabilità già passata.
// Il primo inserimento usa dataInizio = epoch (1970) → copre retroattivamente tutte le ore
// già lavorate (prima non c'era paga). I campi "correnti" restano su Dipendente come specchio
// per la UI e come default. Un record con paga più recente = un aumento/variazione.
model DipendentePagaStorico {
  id                         String     @id @default(cuid())
  dipendenteId               String
  userId                     String
  dataInizio                 DateTime // da quando la tariffa è valida (mezzanotte di Roma in UTC)
  pagaOrariaBaseNetta        Float?
  moltiplicatoreCostoAzienda Float      @default(1.40)
  createdAt                  DateTime   @default(now())
  dipendente                 Dipendente @relation(fields: [dipendenteId], references: [id], onDelete: Cascade)

  @@index([dipendenteId, dataInizio])
  @@index([userId])
}

model Timbratura {
  id           String     @id @default(cuid())
  dipendenteId String
  dipendente   Dipendente @relation(fields: [dipendenteId], references: [id], onDelete: Cascade)
  userId       String
  tipo         String // "entrata" | "uscita"
  timestamp    DateTime   @default(now())

  @@index([dipendenteId])
  @@index([userId])
}

model Turno {
  id             String     @id @default(cuid())
  userId         String
  dipendenteId   String
  data           DateTime
  oraInizio      String
  oraFine        String
  ruolo          String?
  note           String?
  // Contabilità F2 · tariffa applicata al turno. maggiorazione moltiplica il costo orario (1.0 ordinario, 1.15/1.20 straordinario/notturno, 1.30/1.50 festivo/evento). forfaitImporto: se valorizzato, è il costo fisso del turno e ignora ore/maggiorazione (es. "oggi 100€ fissi per l'evento").
  tipoTariffa    String     @default("ordinario") // "ordinario" | "straordinario" | "festivo_evento" | "forfait"
  maggiorazione  Float      @default(1.0)
  forfaitImporto Float?
  createdAt      DateTime   @default(now())
  dipendente     Dipendente @relation(fields: [dipendenteId], references: [id])
  user           User       @relation(fields: [userId], references: [id])

  @@index([userId, data])
  @@index([dipendenteId])
}

model RichiestaDipendente {
  id           String     @id @default(cuid())
  dipendenteId String
  tipo         String
  data         DateTime?
  dataFine     DateTime?
  note         String?
  oraInizio    String?
  oraFine      String?
  status       String     @default("in_attesa")
  createdAt    DateTime   @default(now())
  dipendente   Dipendente @relation(fields: [dipendenteId], references: [id])

  @@index([dipendenteId])
}

model DisponibilitaDipendente {
  id           String     @id @default(cuid())
  dipendenteId String
  mese         DateTime // primo giorno del mese
  giorni       String // JSON: [{data: "2026-07-07", oraInizio: "09:00", oraFine: "17:00", note: ""}]
  createdAt    DateTime   @default(now())
  dipendente   Dipendente @relation(fields: [dipendenteId], references: [id])

  @@unique([dipendenteId, mese])
}

model RequisitiTurni {
  id        String   @id @default(cuid())
  userId    String
  settimana DateTime
  requisiti String // JSON: [{giorno: 0-6, fascia: "pranzo"|"cena"|"mattina", persone: 2, ruolo: "cameriere"}]
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, settimana])
}

model SlotDisponibile {
  id        String   @id @default(cuid())
  userId    String
  data      DateTime
  oraInizio String
  oraFine   String
  durata    Int      @default(60)
  user      User     @relation(fields: [userId], references: [id])
}

model Conversazione {
  id           String   @id @default(cuid())
  userId       String
  clienteNome  String?
  clienteEmail String?
  canale       String   @default("chat")
  messaggi     String
  letta        Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Preventivo {
  id                String   @id @default(cuid())
  userId            String
  leadId            String?
  numero            Int
  tipo              String   @default("preventivo")
  clienteName       String
  clienteEmail      String?
  items             String
  totale            Float
  status            String   @default("bozza")
  note              String?
  tavoliIds         String?
  tokenRisposta     String?  @unique
  messaggioProposta String?
  stockScalato      Boolean  @default(false) // true se la richiesta ha già decrementato il counter dei piatti (asporto/delivery). Serve a ripristinare le porzioni una volta sola in caso di rifiuto/eliminazione.
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Stampante termica per le comande. Transport-agnostica: descrive SOLO dove/cosa serve
// (nome, reparto servito, indirizzo di rete), non COME le si consegna la stampa (PrintNode,
// agente locale, …) — quella è responsabilità del transport (vedi lib/print/transport.ts).
model Stampante {
  id        String     @id @default(cuid())
  userId    String
  nome      String
  reparto   String // reparto servito (Cucina/Bar/…) → match con RigaOrdine.reparto
  indirizzo String? // es "192.168.1.50:9100" per stampanti di rete; null per "altro"
  tipo      String     @default("rete") // "rete" | "altro"
  attiva    Boolean    @default(true)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])
  printJobs PrintJob[]

  @@index([userId])
}

// Coda di stampa delle comande. Un job = una comanda (un reparto di un ordine) pronta da consegnare
// a una stampante. Indipendente dal metodo di consegna: il transport (Mock/PrintNode/Agente) legge
// `contenuto` (ESC/POS in base64) e aggiorna stato/stampataAt. `anteprima` è il ticket renderizzato in
// testo, per verificare il layout senza hardware.
model PrintJob {
  id          String     @id @default(cuid())
  userId      String // scoping veloce della coda per utente (senza join sull'ordine)
  ordineId    String? // nullable: anteprima/test senza ordine
  stampanteId String? // nullable: reparto senza stampante ancora assegnata
  reparto     String // reparto della comanda (routing anche senza stampante)
  contenuto   String // payload comanda: ESC/POS in base64
  anteprima   String? // ticket renderizzato in testo monospace (verifica senza hardware)
  stato       String     @default("in_attesa") // "in_attesa" | "stampata" | "errore"
  errore      String?
  tentativi   Int        @default(0)
  createdAt   DateTime   @default(now())
  stampataAt  DateTime?
  user        User       @relation(fields: [userId], references: [id])
  stampante   Stampante? @relation(fields: [stampanteId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([stato])
}

// ── Flowest Contabilità / Controllo di Gestione (owner-only) ──────────────────
// Tutta questa sezione vive dietro getAuthUser() (Clerk = titolare). I dipendenti
// usano un auth separato (dip_session) confinato alle pagine pubbliche, quindi non
// raggiungono mai questi dati. Regola d'oro: food cost e margini SEMPRE al netto IVA.

// Configurazione contabile del locale (1:1 con User, come MenuStampaConfig).
model ContabilitaConfig {
  id                               String   @id @default(cuid())
  userId                           String   @unique
  aliquotaVenditaDefault           Float    @default(0.10) // somministrazione al tavolo
  percentualeAccantonamentoImposte Float    @default(0.15) // regime ordinario: % sull'EBITDA → fondo imposte stimato
  moltiplicatoreLaborDefault       Float    @default(1.40) // default per i nuovi dipendenti
  regimeFiscale                    String   @default("ordinario") // "ordinario" | "forfettario"
  // Forfettario: l'imposta sostitutiva si calcola su ricavi × coefficiente di redditività
  // (ristorazione ≈ 40%), non sull'utile. Aliquota 15% a regime, 5% per i primi 5 anni.
  coefficienteRedditivita          Float    @default(0.40) // quota dei ricavi considerata reddito (forfettario)
  aliquotaImpostaForfettario       Float    @default(0.15) // 0.15 a regime · 0.05 start-up primi 5 anni
  // Da dove prendere le ore per il costo del personale: "turni" (pianificate, default) o
  // "timbrature" (ore reali entrata/uscita, con fallback ai turni quando mancano i timbri).
  fonteOreLabor                    String   @default("turni") // "turni" | "timbrature"
  // Moltiplicatori "maggiorazione" preferiti dal titolare per ogni tipoTariffa dei turni.
  // JSON { "straordinario": 1.15, "festivo_evento": 1.5, ... }: parte dai default di sistema,
  // ma quando il titolare cambia il moltiplicatore di un turno quel valore diventa il default
  // per quel tipo (festivo/evento/straordinario) finché non lo ricambia. Vuoto = usa i default.
  maggiorazioniDefault             String   @default("{}")
  updatedAt                        DateTime @updatedAt
  user                             User     @relation(fields: [userId], references: [id])
}

// Fattura/bolla di un fornitore (F3). Alimenta l'IVA a credito REALE del cassetto fiscale
// (Σ righe imponibile × aliquota) e il confronto "comprato vs consumato" (food cost teorico).
// NON entra nell'EBITDA: il margine usa il food cost dei piatti venduti (competenza), non gli
// acquisti (cassa). L'imponibile per aliquota si copia dal riquadro "Riepilogo IVA" della fattura.
model Fattura {
  id        String        @id @default(cuid())
  userId    String
  fornitore String?
  numero    String?
  data      DateTime // data documento (competenza IVA)
  categoria String        @default("merci") // "merci"|"bevande"|"servizi"|"altro"
  note      String?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id])
  righe     FatturaRiga[]

  @@index([userId, data])
}

// Riga del castelletto IVA di una fattura: imponibile (netto) per una data aliquota.
model FatturaRiga {
  id         String  @id @default(cuid())
  fatturaId  String
  imponibile Float // netto IVA
  aliquota   Float // 0 | 0.04 | 0.10 | 0.22
  fattura    Fattura @relation(fields: [fatturaId], references: [id], onDelete: Cascade)

  @@index([fatturaId])
}

// Costi fissi/semi-variabili di struttura. Inseriti UNA volta; il rateo giornaliero
// si calcola a runtime (importoNetto normalizzato al mese / 30). Zero data-entry quotidiano.
model CostoFisso {
  id           String   @id @default(cuid())
  userId       String
  voce         String // "Affitto", "Commercialista", "Luce", "TARI", "SIAE", "SaaS"...
  categoria    String   @default("altro") // "affitto"|"utenze"|"servizi"|"personale_extra"|"marketing"|"leasing"|"assicurazioni"|"manutenzioni"|"altro"
  importoNetto Float
  aliquota     Float    @default(0.22)
  periodicita  String   @default("mensile") // "mensile"|"trimestrale"|"annuale"
  attivo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Costi una tantum / spot: NON ricorrenti, legati a un intervallo di date preciso
// (un giorno, una settimana, un mese…). Esempi: un cameriere in più per un evento, una
// riparazione, spese accessorie occasionali. A differenza di CostoFisso (spalmato ogni
// giorno per sempre), qui l'importo netto TOTALE del periodo si spalma SOLO sui giorni tra
// dataInizio e dataFine (inclusa): così il conto economico dei giorni/mesi coinvolti è
// corretto e i periodi non toccati non vedono nulla. Singolo giorno → dataFine = dataInizio.
model CostoUnaTantum {
  id           String   @id @default(cuid())
  userId       String
  voce         String // "Cameriere extra sabato", "Riparazione frigo", "Spese accessorie"…
  categoria    String   @default("altro") // stesse categorie di CostoFisso (incl. "personale_extra")
  importoNetto Float // netto IVA, TOTALE del periodo (verrà spalmato sui giorni)
  aliquota     Float    @default(0.22)
  dataInizio   DateTime // primo giorno coperto (mezzanotte Roma in UTC)
  dataFine     DateTime // ultimo giorno coperto, incluso (= dataInizio se singolo giorno)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, dataInizio])
}

// Snapshot contabile di fine giornata (fuso Europe/Rome). Congela i valori del giorno
// per non ricalcolarli e per aggregare i mesi. Prodotta dal cron serale o on-demand.
model ChiusuraGiorno {
  id                    String   @id @default(cuid())
  userId                String
  data                  DateTime // giorno (mezzanotte italiana)
  fatturatoLordo        Float    @default(0)
  ivaDebito             Float    @default(0)
  fatturatoNetto        Float    @default(0)
  foodCostVenduto       Float    @default(0)
  laborCost             Float    @default(0)
  quotaCostiFissi       Float    @default(0)
  ivaCredito            Float    @default(0) // dalle fatture del giorno (F3); 0 finché non c'è OCR
  ivaNetta              Float    @default(0)
  accantonamentoImposte Float    @default(0)
  utileStimato          Float    @default(0)
  spendibile            Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id])

  @@unique([userId, data])
  @@index([userId, data])
}
